+// SPDX-License-Identifier: MPL-2.0
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFile } from 'node:fs/promises'
+import { createContext, SourceTextModule, SyntheticModule, Script } from 'node:vm'
+import ts from 'typescript'
+import { compileModule } from 'svelte/compiler'
+import * as svelte from 'svelte/internal/client'
+
+async function boot() {
+  const calls = []
+  const storage = new Map()
+  const context = createContext({ console, Map, Set,
+    localStorage: { getItem: key => storage.get(key) ?? null, setItem: (key, value) => storage.set(key, value), removeItem: key => storage.delete(key) }
+  })
+  let hostMessage
+  let pluginMessage
+  let iframe
+  context.window = { addEventListener(name, fn) { if (name === 'message') hostMessage = fn } }
+  context.document = {
+    body: { appendChild() {} },
+    createElement(tag) {
+      const element = { dataset: {}, style: {}, setAttribute() {}, remove() {} }
+      if (tag === 'iframe') { iframe = element; element.contentWindow = { postMessage(data) { pluginMessage?.({ data }) } } }
+      return element
+    }
+  }
+  const moduleFor = (values) => new SyntheticModule(Object.keys(values), function () {
+    for (const [name, value] of Object.entries(values)) this.setExport(name, value)
+  }, { context })
+  const protocol = new SourceTextModule(ts.transpileModule(await readFile('src/lib/plugins/protocol.ts', 'utf8'), { compilerOptions: { target: ts.ScriptTarget.ESNext, module: ts.ModuleKind.ESNext } }).outputText, { context })
+  await protocol.link(() => {}); await protocol.evaluate()
+  let blockedWrite
+  const api = moduleFor({
+    listPlugins: async () => [{ id: 'noisemaker', name: 'Noisemaker', entry: 'index.js', permissions: ['visualizer'], panel: { title: 'Noisemaker' } }],
+    readPluginFile: async () => '',
+    setVisualProgram: async (id, dsl) => { calls.push(['set', id, dsl]); await blockedWrite },
+    clearVisualProgram: async id => { calls.push(['clear', id]) },
+    getVisualSource: async () => "1:0",
+    getVisualProgram: async (source, version) => { calls.push(['get', source, version]); return { source: '1:0', version: 'a', dsl: 'noise()', available: true } }
+  })
+  const modules = { '$lib/api': api, '@tauri-apps/plugin-dialog': moduleFor({ open: () => null }), '$lib/themes': moduleFor({ THEMABLE_KEYS: [] }), './protocol': protocol, 'svelte/internal/client': moduleFor(svelte) }
+  const stripped = ts.transpileModule(await readFile('src/lib/plugins/host.svelte.ts', 'utf8'), { compilerOptions: { target: ts.ScriptTarget.ESNext, module: ts.ModuleKind.ESNext } }).outputText
+  const hostModule = new SourceTextModule(compileModule(stripped, { filename: 'host.svelte.js', generate: 'client' }).js.code, { context })
+  await hostModule.link(name => { assert.ok(modules[name], `Unexpected module ${name}`); return modules[name] })
+  await hostModule.evaluate()
+  const host = hostModule.namespace.pluginHost
+  await host.start()
+  await host.setEnabled('noisemaker', true)
+  await host.attach('noisemaker', { appendChild() {} })
+  const pluginContext = createContext({ console, Map, Set, Error,
+    window: { addEventListener(name, fn) { if (name === 'message') pluginMessage = fn } },
+    parent: { postMessage(data) { hostMessage({ data, source: iframe.contentWindow }) } }
+  })
+  new Script(protocol.namespace.RUNTIME_SHIM).runInContext(pluginContext)
+  return { host, calls, get plugin() { return pluginContext.window.veilamp }, ready() { new Script(protocol.namespace.RUNTIME_SHIM).runInContext(pluginContext) }, block(promise) { blockedWrite = promise } }
+}
+
+test('The sandbox binds DSL writes to its plugin id and uses the existing visualizer grant', async () => {
+  const app = await boot()
+  await app.plugin.visualizer.setProgram('noise()')
+  await app.plugin.visualizer.program('1:0', 'a')
+  assert.deepEqual(app.calls, [['set', 'noisemaker', 'noise()'], ['get', '1:0', 'a']])
+  await app.host.setGranted('noisemaker', 'visualizer', false)
+  assert.deepEqual(app.calls.at(-1), ['clear', 'noisemaker'])
+  await assert.rejects(app.plugin.visualizer.setProgram('voronoi()'), /not granted/)
+})
+
+test('Disabling a plugin clears a write that was already in flight', async () => {
+  const app = await boot()
+  let finish
+  app.block(new Promise(resolve => { finish = resolve }))
+  const write = app.plugin.visualizer.setProgram('noise()')
+  await new Promise(resolve => setImmediate(resolve))
+  const disable = app.host.setEnabled('noisemaker', false)
+  finish()
+  await Promise.all([write, disable])
+  assert.deepEqual(app.calls, [['set', 'noisemaker', 'noise()'], ['clear', 'noisemaker']])
+})
+
+
+test('A pending disable cannot stop a newly enabled plugin', async () => {
+  const app = await boot()
+  let finish
+  app.block(new Promise(resolve => { finish = resolve }))
+  const write = app.plugin.visualizer.setProgram('noise()')
+  await new Promise(resolve => setImmediate(resolve))
+  const disable = app.host.setEnabled('noisemaker', false)
+  await app.host.setEnabled('noisemaker', true)
+  await app.host.attach('noisemaker', { appendChild() {} })
+  finish()
+  await Promise.all([write, disable])
+  app.ready()
+  const runtime = app.host.runtimes.find(item => item.manifest.id === 'noisemaker')
+  assert.equal(runtime.enabled, true)
+  assert.equal(runtime.status, 'running')
+  await app.plugin.visualizer.setProgram('voronoi()')
+  assert.deepEqual(app.calls, [['set', 'noisemaker', 'noise()'], ['clear', 'noisemaker'], ['set', 'noisemaker', 'voronoi()']])
+})
