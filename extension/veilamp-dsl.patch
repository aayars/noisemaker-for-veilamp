+++ b/app/veilamp/src-tauri/src/visuals.rs
@@ -0,0 +1,66 @@
+// SPDX-License-Identifier: MPL-2.0
+// Exchange DSL through the current friend's existing private route.
+use std::sync::Arc;
+use serde::Serialize;
+use tauri::State;
+use veilamp_net::{node::Net, visual::VisualStore};
+use crate::{AppState, NetState, QueueItem};
+
+pub struct VisualState(pub Arc<VisualStore>);
+
+#[derive(Serialize)]
+pub struct VisualProgram {
+    source: Option<String>,
+    version: Option<String>,
+    dsl: Option<String>,
+    available: bool,
+}
+
+#[derive(PartialEq)]
+struct Source { epoch: u64, index: usize, friend: String, track: i64 }
+
+fn source(state: &AppState) -> Option<Source> {
+    let queue = state.queue.lock().unwrap();
+    match queue.items.get(queue.index) {
+        Some(QueueItem::Remote(entry)) => Some(Source {
+            epoch: queue.epoch, index: queue.index, friend: entry.friend_key.clone(), track: entry.track_id,
+        }),
+        _ => None,
+    }
+}
+
+#[tauri::command]
+pub fn get_visual_source(state: State<AppState>) -> Option<String> {
+    source(&state).map(|s| format!("{}:{}", s.epoch, s.index))
+}
+
+#[tauri::command]
+pub fn set_visual_program(state: State<VisualState>, id: String, dsl: String) -> Result<(), String> {
+    state.0.set(&id, &dsl).map_err(str::to_string)
+}
+
+#[tauri::command]
+pub fn clear_visual_program(state: State<VisualState>, id: String) {
+    state.0.clear(&id);
+}
+
+#[tauri::command]
+pub async fn get_visual_program(state: State<'_, AppState>, net: State<'_, NetState>, known_source: Option<String>, known_version: Option<String>) -> Result<VisualProgram, String> {
+    let Some(start) = source(&state) else {
+        return Ok(VisualProgram { source: None, version: None, dsl: None, available: true });
+    };
+    let token = format!("{}:{}", start.epoch, start.index);
+    let handle: Arc<Net> = match crate::net_handle(&net) {
+        Ok(handle) => handle,
+        Err(_) => return Ok(VisualProgram { source: Some(token), version: None, dsl: None, available: false }),
+    };
+    let known = if known_source.as_deref() == Some(token.as_str()) { known_version.as_deref() } else { None };
+    let received = tokio::time::timeout(std::time::Duration::from_secs(20), handle.fetch_visual_program(&start.friend, start.track, known))
+        .await;
+    if source(&state).as_ref() != Some(&start) { return Err("The audio source changed.".to_string()); }
+    let (version, dsl) = match received {
+        Ok(Ok(program)) => program,
+        _ => return Ok(VisualProgram { source: Some(token), version: None, dsl: None, available: false }),
+    };
+    Ok(VisualProgram { source: Some(token), version, dsl, available: true })
+}
