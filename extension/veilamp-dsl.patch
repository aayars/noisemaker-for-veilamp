 }
+
+// Fetch a version first. Each program chunk must belong to that version.
+pub async fn fetch_visual_program(net: &Net, friend: &str, track_id: i64, known: Option<&str>) -> Result<(Option<String>, Option<String>)> {
+    use crate::visual::{valid_version, VisualDownload};
+    let presence = friend_presence_key(&net.table, friend).await?;
+    let (target, _) = resolve_route_by_presence(&net.api, &net.rc, &presence).await?;
+    let requester = net.identity.public_key.to_string();
+    let pubkey = &net.identity.public_key;
+    let secret = net.identity.keypair.secret();
+    let timeout = Duration::from_secs(5);
+    let response = signed_request(&net.api, &net.rc, &requester, pubkey, &secret, &target,
+        &Resource::VisualStatus { track_id }, 0, timeout, None).await?;
+    let version = match response {
+        Response::Ok { total_len: 0, data } if data.is_empty() => return Ok((None, None)),
+        Response::Ok { total_len: 48, data } if data.len() == 48 => String::from_utf8(data)?,
+        Response::Err(e) => return Err(anyhow!(e)),
+        _ => return Err(anyhow!("The visual version is invalid.")),
+    };
+    if !valid_version(&version) { return Err(anyhow!("The visual version is invalid.")); }
+    if known == Some(version.as_str()) { return Ok((Some(version), None)); }
+    let resource = Resource::VisualProgram { track_id, version: version.clone() };
+    let mut download: Option<VisualDownload> = None;
+    loop {
+        let offset = download.as_ref().map_or(0, VisualDownload::offset) as u32;
+        match signed_request(&net.api, &net.rc, &requester, pubkey, &secret, &target, &resource, offset, timeout, None).await? {
+            Response::Ok { total_len, data } => {
+                let total = total_len as usize;
+                if download.is_none() { download = Some(VisualDownload::new(total).map_err(|e| anyhow!(e))?); }
+                let buffer = download.as_mut().unwrap();
+                buffer.append(total, &data).map_err(|e| anyhow!(e))?;
+                if buffer.complete() { break; }
+            }
+            Response::Err(e) => return Err(anyhow!(e)),
+        }
+    }
+    let dsl = download.unwrap().finish().map_err(|e| anyhow!(e))?;
+    Ok((Some(version), Some(dsl)))
+}
