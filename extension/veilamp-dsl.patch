--- /dev/null
+++ b/crates/veilamp-net/src/visual.rs
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: MPL-2.0
+// Store one bounded DSL program in memory. Never store pixels or media here.
+use std::sync::Mutex;
+
+pub const MAX_DSL_BYTES: usize = 256 * 1024;
+
+type VisualResult<T> = Result<T, &'static str>;
+
+struct Current {
+    epoch: [u8; 16],
+    revision: u64,
+    program: Option<(String, String)>,
+}
+
+pub struct VisualStore(Mutex<Current>);
+
+impl VisualStore {
+    pub fn new(epoch: [u8; 16]) -> Self {
+        Self(Mutex::new(Current { epoch, revision: 0, program: None }))
+    }
+
+    pub fn set(&self, owner: &str, dsl: &str) -> VisualResult<()> {
+        validate_dsl(dsl)?;
+        let mut current = self.0.lock().unwrap();
+        if current.program.as_ref().is_some_and(|(id, text)| id == owner && text == dsl) {
+            return Ok(());
+        }
+        current.revision = current.revision.checked_add(1).ok_or("Visual revision limit reached.")?;
+        current.program = Some((owner.to_owned(), dsl.to_owned()));
+        Ok(())
+    }
+
+    pub fn clear(&self, owner: &str) {
+        let mut current = self.0.lock().unwrap();
+        if current.program.as_ref().is_some_and(|(id, _)| id == owner) {
+            current.program = None;
+        }
+    }
+
+    pub fn status(&self, shared: bool) -> VisualResult<Option<String>> {
+        if !shared { return Err("The track is not shared."); }
+        let current = self.0.lock().unwrap();
+        Ok(current.program.as_ref().map(|_| version(&current)))
+    }
+
+    pub fn chunk(&self, shared: bool, expected: &str, offset: usize, want: usize) -> VisualResult<(usize, Vec<u8>)> {
+        if !shared { return Err("The track is not shared."); }
+        let current = self.0.lock().unwrap();
+        if !valid_version(expected) || expected != version(&current) {
+            return Err("The visual program changed.");
+        }
+        let (_, dsl) = current.program.as_ref().ok_or("No visual program is available.")?;
+        if offset >= dsl.len() || want == 0 { return Err("The visual range is invalid."); }
+        let end = offset.saturating_add(want).min(dsl.len());
+        Ok((dsl.len(), dsl.as_bytes()[offset..end].to_vec()))
+    }
+}
+
+fn version(current: &Current) -> String {
+    let epoch: String = current.epoch.iter().map(|b| format!("{b:02x}")).collect();
+    format!("{epoch}{:016x}", current.revision)
+}
+
+pub fn valid_version(value: &str) -> bool {
+    value.len() == 48 && value.bytes().all(|b| b.is_ascii_hexdigit())
+}
+
+pub fn validate_dsl(dsl: &str) -> VisualResult<()> {
+    if dsl.trim().is_empty() || dsl.len() > MAX_DSL_BYTES || dsl.contains('\0') || dsl.to_ascii_lowercase().contains("data:") {
+        return Err("The DSL program is invalid or exceeds 256 KiB.");
+    }
+    Ok(())
+}
+
+pub struct VisualDownload {
+    total: usize,
+    bytes: Vec<u8>,
+}
+
+impl VisualDownload {
+    pub fn new(total: usize) -> VisualResult<Self> {
+        if total == 0 || total > MAX_DSL_BYTES { return Err("The visual program size is invalid."); }
+        Ok(Self { total, bytes: Vec::with_capacity(total) })
+    }
+
+    pub fn offset(&self) -> usize { self.bytes.len() }
+    pub fn complete(&self) -> bool { self.bytes.len() == self.total }
+
+    pub fn append(&mut self, total: usize, data: &[u8]) -> VisualResult<()> {
+        if total != self.total || data.is_empty() || data.len() > 28 * 1024 || self.bytes.len().saturating_add(data.len()) > self.total {
+            return Err("The visual program chunk is invalid.");
+        }
+        self.bytes.extend_from_slice(data);
+        Ok(())
+    }
+
+    pub fn finish(self) -> VisualResult<String> {
+        if self.bytes.len() != self.total { return Err("The visual program is incomplete."); }
+        let dsl = String::from_utf8(self.bytes).map_err(|_| "The visual program is not UTF-8.")?;
+        validate_dsl(&dsl)?;
+        Ok(dsl)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn changing_the_program_invalidates_old_chunks() {
+        let store = VisualStore::new([1; 16]);
+        store.set("noisemaker", "noise().write(o0)").unwrap();
+        let first = store.status(true).unwrap().unwrap();
+        assert_eq!(store.chunk(true, &first, 0, 7).unwrap().1, b"noise()");
+        store.set("noisemaker", "voronoi().write(o0)").unwrap();
+        assert!(store.chunk(true, &first, 7, 7).is_err());
+        assert_ne!(store.status(true).unwrap().unwrap(), first);
+    }
+
+    #[test]
+    fn only_shared_tracks_expose_a_program() {
+        let store = VisualStore::new([1; 16]);
+        store.set("noisemaker", "noise()").unwrap();
+        let version = store.status(true).unwrap().unwrap();
+        assert!(store.status(false).is_err());
+        assert!(store.chunk(false, &version, 0, 7).is_err());
+    }
+
+    #[test]
+    fn invalid_programs_do_not_replace_the_current_program() {
+        let store = VisualStore::new([1; 16]);
+        store.set("noisemaker", "noise()").unwrap();
+        let version = store.status(true).unwrap();
+        for invalid in ["".to_string(), " ".to_string(), "x".repeat(MAX_DSL_BYTES + 1), "data:image/png;base64,x".to_string()] {
+            assert!(store.set("noisemaker", &invalid).is_err());
+            assert_eq!(store.status(true).unwrap(), version);
+        }
+    }
+
+    #[test]
+    fn a_plugin_cannot_clear_another_plugins_program() {
+        let store = VisualStore::new([1; 16]);
+        store.set("noisemaker", "noise()").unwrap();
+        store.clear("other");
+        assert!(store.status(true).unwrap().is_some());
+        store.clear("noisemaker");
+        assert!(store.status(true).unwrap().is_none());
+    }
+
+    #[test]
+    fn versions_do_not_repeat_after_a_restart() {
+        let first = VisualStore::new([1; 16]);
+        let next = VisualStore::new([2; 16]);
+        first.set("n", "noise()").unwrap();
+        next.set("n", "noise()").unwrap();
+        assert_ne!(first.status(true).unwrap(), next.status(true).unwrap());
+    }
+
+    #[test]
+    fn a_download_rejects_oversize_truncated_and_mixed_snapshots() {
+        assert!(VisualDownload::new(MAX_DSL_BYTES + 1).is_err());
+        let mut download = VisualDownload::new(7).unwrap();
+        download.append(7, b"noise").unwrap();
+        assert!(download.append(8, b"()").is_err());
+        assert!(download.append(7, b"").is_err());
+        assert!(download.append(7, b"abc").is_err());
+        assert!(download.finish().is_err());
+        let mut download = VisualDownload::new(7).unwrap();
+        download.append(7, b"noise").unwrap();
+        download.append(7, b"()").unwrap();
+        assert_eq!(download.finish().unwrap(), "noise()");
+    }
+}
